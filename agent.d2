# SIM 当前结构 · 2026-11-05 · sim-v2-9
# d2 agent.d2 dist/architecture/agent.svg
# d2 --target layers.decision agent.d2 dist/architecture/decision.svg
direction: down

title: "SIM 当前运行结构\nsim-v2-9 · 单模型持续决策" {shape: text}
player: "玩家 / Minecraft 聊天"
transport: "MineflayerChatTransport\n接收消息 / whisper 或 chat 回复"
interaction: "AgentLoop · agent-loop.ts\n权限 / 限流 / 去重 / 精确本地控制\n目标、原话、修订、预算、证据与持续执行" {style.fill: "#e8f1ff"}
brain: "AgentBrain · 唯一 decision 模型\n理解 / 查询 / 选动作 / 纠错 / 完成判断\n无主控与执行模型交接" {style.fill: "#e8f1ff"}
stage: "可选 StagePlan\n有界循环、分支、结果绑定\n正常节点之间无模型调用" {style.fill: "#e7f5ec"}
scheduler: "TaskScheduler\n短批次或阶段节点 → 原生动作步骤" {style.fill: "#e7f5ec"}
controller: "ActionController → ActionExecutor\n单写入者、取消、原生租约和执行证据" {style.fill: "#e7f5ec"}
actions: "MinecraftActions → Mineflayer\n45 动作 = 44 原生 + operate 网关" {style.fill: "#e7f5ec"}
data: "Observations · 14 种只读查询\n统一目标 ref、背包、配方、掉落物过滤\n当前客户端已加载范围" {style.fill: "#f1eafe"}
store: "FileAgentStore / MemoryAgentStore\n持久目标、事件、未确认操作\n恢复先观察对账，不盲目重放" {style.fill: "#f1eafe"}
finish: "finish → 程序核对要求覆盖 / 证据引用\n完整任务通过才标记完成\n无独立验收模型"
game: "Minecraft Java 服务器\n项目目标 1.21.1；本版尚未实机复测"
diagnostics: "DiagnosticBus + 本机只读诊断台\n模型、工具、目标与错误事件 / JSONL"
boundary: "当前边界\n模型仍可能误解目标或证据\n无通用长期经验学习 / 多目标并行" {style.fill: "#fff0d9"}
player <-> transport: "消息 / 回复"
transport <-> interaction
interaction <-> brain: "player_message / goal_step → 结构化决定"
interaction -> stage: "plan（可选）"
interaction -> scheduler: "propose / 本地控制"
stage -> scheduler: "逐节点写入"
scheduler -> controller
controller -> actions
actions <-> game
interaction -> data: "query / 新快照"
stage -> data: "阶段查询"
data -> interaction: "当前证据、ref、结果路径"
scheduler -> interaction: "实际结果 / 失败 → 同一模型继续"
interaction <-> store
interaction -> finish: "finish"
finish -> interaction: "完成 / 剩余要求"
interaction -> diagnostics: "只读旁路"
brain -> boundary: "语义准确率仍需实测" {style.stroke-dash: 4}

layers: {
  decision: {
    direction: down
    title: "单模型决策循环 · sim-v2-9" {shape: text}
    input: "玩家消息"
    local: "精确 stop / cancel / pause / resume\n本地控制；取消在途模型与未开始动作"
    model: "AgentBrain.infer(decision)\n同一提示词 / Schema\nplayer_message 或 goal_step" {style.fill: "#e8f1ff"}
    context: "当前目标、原话、要求、近期观测\nlastTool / lastFailure / queryContracts\n证据索引与可用操作目录" {style.fill: "#f1eafe"}
    goal: "新建 / 修订持续目标"
    reply: "回复 / 必要澄清 / 等待"
    query: "query / read_evidence\n执行后自动回到同一模型"
    write: "propose：1–4个已绑定动作\nplan：可选有界重复阶段"
    program: "Schema、引用、前置条件、预算\n单一调度与执行器；取消不提前释放原生租约"
    result: "真实工具结果 / 已发生效果\n阶段错误：节点、缺失路径、可用字段"
    pending: "待确认副作用\n观察 → reconcile → 允许新写入"
    finish: "finish：同一模型按要求给出证据\n程序核对引用与覆盖；不增加模型复核"
    done: "持久完成状态 / 玩家反馈"
    input -> local: "精确内置控制"
    input -> model: "其余消息"
    context -> model
    model -> goal: "goal"
    goal -> context
    model -> reply: "respond / ask / wait / blocked"
    model -> query
    query -> result
    model -> write
    write -> program
    program -> result
    result -> context
    result -> pending: "存在未确认效果"
    pending -> context
    model -> finish
    finish -> done: "全部满足"
    finish -> context: "未满足"
  }
  execution: {
    direction: down
    title: "调度与执行细图 · 每 Bot 唯一写通道" {shape: text}
    task: "Task / TaskStep · task.ts\n技能或动作数组、前后置条件\n优先级 / 截止时间 / dependsOn / 可选 retry"
    scheduler: "TaskScheduler\n校验 / 依赖 / 优先级；每次派发一步\nqueued / running / paused / cancelling\ncompleted / failed / cancelled / blocked" {style.fill: "#e7f5ec"}
    ledger: "MemoryTaskLedger（默认实际装配）\nTaskLedger 是可替换接口\n载入 running / cancelling 有 RECOVERY_REQUIRED 防护\n调度账本为内存；V2 目标事件由 FileAgentStore 持久化并对账" {style.fill: "#f0f0f0"}
    controller: "ActionController.execute\n单步骤 active / 取消 / 截止时间\n前置检查 → 执行 → 后置检查\n汇总证据、进度、部分效果" {style.fill: "#e7f5ec"}
    skills: "仅 legacy：SkillRunner + DEFAULT_SKILLS\n7 动态技能：找资源、导航、拾取、采木、制作、存入、交付\nSkillContext：query / execute / check / report\n组合策略在技能内，不直接持有 Bot"
    actions: "MinecraftActions.execute → ActionExecutor\nSchema / ready / busy；唯一原生动作租约\n超时 / AbortSignal / 清理\n取消可先返回，原生结束前仍占租约" {style.fill: "#e7f5ec"}
    gateway: "operate · operation-gateway.ts\n44 种模型操作，按版本 / 能力过滤\n目标 / 物品 / 报价引用绑定为原生 Action\n同一租约内 run，不递归 execute 获取租约"
    native: "MinecraftActions.run / extensions / crafting\n44 原生动作；多步副作用前检查取消\n窗口清理及导航终点 / 放置 / 装备等局部复查\n底层不隐藏规划或自动重试"
    observations: "Observations：只读 query / verify\n14 种查询；统一引用注册表、本地配方服务\n引用每 Bot 有界、30 秒 TTL，执行前复查\n出生 / 死亡 / 维度切换 / dispose 清空引用" {style.fill: "#f1eafe"}
    bot: "Mineflayer / pathfinder → 服务器\n默认寻路禁止挖掘与搭柱\n死亡 / 断连触发停止；维度切换有专用等待例外"
    result: "ControllerResult → 调度状态 → AgentLoop 证据\nstatus / evidence / data / partialEffects / leaseState\nstep_verified 是局部结果，非最终目标验收" {style.fill: "#fff0d9"}
    task -> scheduler
    scheduler <-> ledger: "读写内存记录"
    scheduler -> controller: "ControllerCommand"
    controller -> skills: "step.skill"
    controller -> actions: "step.actions 顺序执行"
    skills -> actions: "经同一 ActionPort.execute"
    controller -> observations: "经 actions.query 校验条件" {style.stroke-dash: 4}
    skills -> observations: "经 actions.query 观察" {style.stroke-dash: 4}
    actions -> gateway: "operate"
    gateway -> observations: "复查引用" {style.stroke-dash: 4}
    gateway -> native: "同一租约内调用"
    actions -> native: "直接原生 Action"
    native <-> bot: "调用 / 状态"
    native -> actions: "结果 / 错误 / 客户端证据"
    controller -> result: "技能结果或动作回执 + 条件检查"
    result -> scheduler: "更新步骤与任务状态"
    scheduler -> controller: "cancel / stop → 取消 active 与原生动作" {
      style.stroke: "#b44233"
      style.stroke-dash: 4
    }
    scheduler -> scheduler: "仅显式 retry + idempotent 按策略重试"
  }
  diagnostics: {
    direction: down
    title: "诊断细图 · 只读旁路，不参与游戏控制" {shape: text}
    runtime: "CompanionRuntime + wireDiagnostics\n输入、模型、校验、分发、任务\n步骤、动作、查询、反馈、回复、运行事件"
    bus: "DiagnosticBus · diagnostics.ts\ntraceId / taskId 关联\n写入前脱敏、深度 / 大小 / 条数限制" {style.fill: "#f1eafe"}
    memory: "内存事件缓冲\nRuntime 默认不持久化"
    file: "logs/diagnostics.jsonl（Git 忽略）\nexamples/companion.ts 显式配置文件记录\n诊断历史，不是可恢复任务账本" {shape: cylinder}
    server: "startDiagnosticServer\n仅监听 127.0.0.1:4318\nGET 页面 / api/events / api/export\nHost / Origin 检查；无游戏写接口"
    standalone: "examples/diagnostics.ts\n独立诊断台增量跟踪同一日志\n不登录游戏、不请求模型"
    gui: "gui/diagnostics.html\n按指令查看模型 / 程序 / 执行对照\n实时、回放、导入、导出、阻断筛选"
    note: "证据边界\n结构通过不代表意图正确\n发送回复不代表玩家已收到\n演示明确标注，不是真实调用\n未采集的旧历史无法还原" {style.fill: "#fff0d9"}
    runtime -> bus: "旁路采集"
    bus -> memory
    bus -> file: "入口启用时追加"
    memory -> server: "snapshot"
    file -> standalone: "持久回放 / 增量读取"
    standalone -> server: "独立进程也可提供只读界面"
    server -> gui: "HTTP 读取"
    gui -> note: "区分事实与推断" {style.stroke-dash: 4}
  }
}
