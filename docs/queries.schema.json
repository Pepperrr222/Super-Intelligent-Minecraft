              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "entity_near"
                },
                "entityId": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
