                "distance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 32
                }
              },
              "required": [
                "kind",
                "entityId",
                "distance"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "health_at_least"
                },
                "health": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20
                }
              },
              "required": [
                "kind",
