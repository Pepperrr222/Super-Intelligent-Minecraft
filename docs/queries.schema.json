          "default": 16,
          "type": "number",
          "minimum": 1,
          "maximum": 32
        }
      },
      "required": [
        "type",
        "radius"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "inspect_block"
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "z": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "position"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "find_blocks"
        },
        "names": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
