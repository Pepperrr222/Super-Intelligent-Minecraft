            "minLength": 1,
            "maxLength": 100
          }
        },
        "radius": {
          "default": 16,
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "limit": {
          "default": 32,
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      },
      "required": [
        "type",
        "names",
        "radius",
        "limit"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "recipes"
        },
        "item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "table": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "z": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "item"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "verify"
        },
        "condition": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "inventory_at_least"
                },
                "item": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2304
                }
              },
              "required": [
                "kind",
                "item",
                "count"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
